{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "musren",
  "version": "1.4.0",
  "identifier": "com.cosmiclatte.musren",
  "build": {
    "beforeDevCommand": "bun run build:worker && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:worker && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "musren",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "externalBin": ["binaries/musren-worker"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
